@baseUrl = http://localhost:5080
@contoso = 11111111-1111-1111-1111-111111111111
@fabrikam = 22222222-2222-2222-2222-222222222222
# Replace with today's UTC date.
@today = 2026-01-01

### Contoso: most recent activity
GET {{baseUrl}}/tenants/{{contoso}}/events?page=1&pageSize=10

### Contoso: today's activity
GET {{baseUrl}}/tenants/{{contoso}}/events?from={{today}}&to={{today}}

### Fabrikam: most recent activity
GET {{baseUrl}}/tenants/{{fabrikam}}/events?page=1&pageSize=10

### Emit an event
POST {{baseUrl}}/tenants/{{contoso}}/events
Content-Type: application/json

{
  "messageId": "manual-1",
  "eventType": "record.created",
  "actor": "alice@contoso.test",
  "target": "Q4 Forecast",
  "targetType": "report"
}
